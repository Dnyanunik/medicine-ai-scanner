{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/medicine-label-reader/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
